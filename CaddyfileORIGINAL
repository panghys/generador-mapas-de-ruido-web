gespro.inf.uach.cl {

    encode gzip zstd

    # --- API Django ---
    @api path /api/*
    handle @api {
        reverse_proxy gespro-gespro-frontend-1:3003
    }

    # --- Superset ---
    @superset path /superset/*
    handle @superset {
        uri strip_prefix /superset
        reverse_proxy gespro-superset-1:4003 {
            header_up Host {host}
        }
    }

    # --- Static assets ---
    @superset_assets path /static/assets/*
    handle @superset_assets {
        reverse_proxy gespro-superset-1:4003
    }

    # --- Frontend Django ---
    handle {
        reverse_proxy gespro-gespro-frontend-1:3003
    }

    # --- SPA Fallback ---
    handle_errors
    handle {
        try_files {path} /index.html
        file_server
    }
}
totem.inf.uach.cl {
  encode gzip zstd

  # --- API ---
  @api path /api/*
  handle @api {
    reverse_proxy totem_backend:4004
  }

  # --- ADMIN ---
  @admin path /admin*
  handle @admin {
    uri strip_prefix /admin
    reverse_proxy totem_frontend_admin:6004 {
      header_up Host {host}
    }
  }

  # --- FRONTEND PÚBLICO ---
  handle {
    reverse_proxy totem_frontend:3004 {
      header_up Host {host}
    }
  }

  # --- FALLBACK SPA ---
  handle_errors
  handle {
    try_files {path} /index.html
    file_server
  }

  log {
    output file /var/log/caddy/totem_access.log
  }
}

