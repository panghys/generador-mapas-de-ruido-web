raec.inf.uach.cl {
  @api path /api/*
  handle @api {
    reverse_proxy raec-backend:4001
  }


  handle {
    reverse_proxy raec-frontend:3001
  }

  handle {
    try_files {path} /index.html
    file_server
  }
}



